{
    "name": "@intrepidshape/dapp-gen",
    "version": "0.2.0",
    "description": "Pull a verified contract from any EVM chain and generate a type-safe Elm dapp frontend — zero JS runtime deps, pure-Elm ABI encoding.",
    "keywords": [
        "ethereum",
        "evm",
        "dapp",
        "elm",
        "codegen",
        "abi",
        "web3",
        "typescript",
        "scaffold"
    ],
    "homepage": "https://github.com/IntrepidShape/dapp-gen",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/IntrepidShape/dapp-gen.git"
    },
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "src/**/*.ts",
        "templates/**/*",
        "README.md",
        "RELEASE.md",
        "tsconfig.json"
    ],
    "license": "MIT",
    "type": "module",
    "bin": {
        "dapp-gen": "./src/cli.ts"
    },
    "scripts": {
        "dapp-gen": "bun src/cli.ts",
        "test": "bun test"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "typescript": "^5.0.0",
        "viem": "^2.48.11"
    }
}
